<?xml version="1.0" encoding="UTF-8"?>
<!--
  Browser-facing XSLT view for the sitemap XML files. Search engines parse
  the raw XML and ignore this stylesheet (per sitemaps.org); humans hit
  /sitemap.xml in a browser and get the friendly HTML rendering below.
  Handles both <sitemapindex> (parent /sitemap.xml) and <urlset>
  (the per-CPT sub-sitemaps).
-->
<xsl:stylesheet
  version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:s="http://www.sitemaps.org/schemas/sitemap/0.9"
  exclude-result-prefixes="s"
>
  <xsl:output method="html" version="5.0" encoding="UTF-8" indent="yes" doctype-system="about:legacy-compat" />

  <xsl:template match="/">
    <html lang="en">
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>XML Sitemap</title>
        <style>
          *, *::before, *::after { box-sizing: border-box; }
          html, body { margin: 0; padding: 0; }
          body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
              "Helvetica Neue", Arial, sans-serif;
            color: #0a0a0a;
            background: #f0f0f0;
            -webkit-font-smoothing: antialiased;
            line-height: 1.5;
          }
          a { color: #1e6bff; text-decoration: none; }
          a:hover { text-decoration: underline; }
          .wrap {
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 24px 64px;
          }
          h1 {
            font-size: 2.5rem;
            line-height: 1.1;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin: 0 0 16px;
          }
          .lede {
            font-size: 0.95rem;
            color: #525252;
            margin: 0 0 12px;
            max-width: 720px;
          }
          .lede a { font-weight: 600; }
          /* Inline plain-text link variant — used for the plugin credit so it
             reads as part of the prose rather than a call to action. */
          .lede a.plain {
            color: inherit;
            font-weight: inherit;
            text-decoration: none;
          }
          .lede a.plain:hover { text-decoration: underline; }
          .count {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            margin: 24px 0 20px;
            background: #ffffff;
            border-radius: 9999px;
            font-size: 0.85rem;
            color: #404040;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
          }
          .count strong { color: #0a0a0a; font-weight: 700; }
          .card {
            background: #ffffff;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04),
              0 8px 24px -12px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(0, 0, 0, 0.04);
          }
          table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
          }
          thead {
            background: #eef2fb;
          }
          th {
            text-align: left;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-size: 0.7rem;
            color: #525252;
            padding: 14px 20px;
            font-weight: 700;
          }
          th.num { width: 60px; }
          th.date {
            width: 220px;
            text-align: right;
          }
          td {
            padding: 14px 20px;
            border-top: 1px solid #f0f0f0;
            vertical-align: middle;
          }
          td.num { color: #a3a3a3; font-variant-numeric: tabular-nums; }
          td.date {
            text-align: right;
            color: #525252;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
          }
          td.url { word-break: break-all; }
          tr:hover td { background: #fafafa; }
          footer {
            margin-top: 32px;
            font-size: 0.8rem;
            color: #a3a3a3;
          }
          footer a { color: #525252; font-weight: 500; }
          @media (max-width: 640px) {
            .wrap { padding: 32px 16px 48px; }
            h1 { font-size: 1.85rem; }
            th, td { padding: 10px 12px; }
            th.date, td.date { width: auto; }
          }
        </style>
      </head>
      <body>
        <div class="wrap">
          <h1>XML Sitemap</h1>
          <p class="lede">
            This XML Sitemap is generated by
            <a class="plain" href="https://teqzerodigital.com" target="_blank" rel="noopener">TeqzWP SEO Plugin</a>.
            It is what search engines like Google use to crawl and re-crawl pages on your website.
          </p>
          <p class="lede">
            Learn more about
            <a href="https://www.sitemaps.org/" target="_blank" rel="noopener">XML Sitemaps</a>.
          </p>

          <xsl:choose>
            <xsl:when test="s:sitemapindex">
              <div class="count">
                <strong><xsl:value-of select="count(s:sitemapindex/s:sitemap)" /></strong>
                <span>sitemaps in this index</span>
              </div>
              <div class="card">
                <table>
                  <thead>
                    <tr>
                      <th class="num">#</th>
                      <th>Sitemap</th>
                      <th class="date">Last Modified</th>
                    </tr>
                  </thead>
                  <tbody>
                    <xsl:for-each select="s:sitemapindex/s:sitemap">
                      <tr>
                        <td class="num">
                          <xsl:value-of select="position()" />.
                        </td>
                        <td class="url">
                          <a href="{s:loc}">
                            <xsl:value-of select="s:loc" />
                          </a>
                        </td>
                        <td class="date">
                          <xsl:value-of select="s:lastmod" />
                        </td>
                      </tr>
                    </xsl:for-each>
                  </tbody>
                </table>
              </div>
            </xsl:when>
            <xsl:otherwise>
              <div class="count">
                <strong><xsl:value-of select="count(s:urlset/s:url)" /></strong>
                <span>URLs in this sitemap</span>
              </div>
              <div class="card">
                <table>
                  <thead>
                    <tr>
                      <th class="num">#</th>
                      <th>URL</th>
                      <th class="date">Last Modified</th>
                    </tr>
                  </thead>
                  <tbody>
                    <xsl:for-each select="s:urlset/s:url">
                      <tr>
                        <td class="num">
                          <xsl:value-of select="position()" />.
                        </td>
                        <td class="url">
                          <a href="{s:loc}">
                            <xsl:value-of select="s:loc" />
                          </a>
                        </td>
                        <td class="date">
                          <xsl:value-of select="s:lastmod" />
                        </td>
                      </tr>
                    </xsl:for-each>
                  </tbody>
                </table>
              </div>
            </xsl:otherwise>
          </xsl:choose>

          <footer>
            Powered by
            <a href="https://teqzerodigital.com" target="_blank" rel="noopener">Teqzero Digital - Build. Automate. Scale</a>
            &#183; Following the
            <a href="https://www.sitemaps.org/protocol.html" target="_blank" rel="noopener">sitemaps.org</a>
            protocol.
          </footer>
        </div>
      </body>
    </html>
  </xsl:template>
</xsl:stylesheet>
