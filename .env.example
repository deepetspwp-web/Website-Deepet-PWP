# ---------------------------------------------------------------------------
# Firebase (database + image storage)
# Firebase console → ⚙ Project settings → Service accounts → Generate new private key.
# Copy these three values from the downloaded JSON file.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# Paste the whole private_key value, keeping the \n sequences, inside double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Firebase console → Storage → the bucket name shown at the top (without gs://).
FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"

# Signs the admin login cookie. Any long random string.
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Old Neon database — only needed once, to copy existing leads into Firebase
# with scripts/migrate-to-firebase.mjs. Remove after migrating.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Google reCAPTCHA v3 keys
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key"
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key"

# Email Delivery (Optional SMTP for notifications)
SMTP_USER=""
SMTP_PASS=""

# Mailjet (booking notification emails)
MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
MAILJET_SENDER_EMAIL="contact@deepetservices.com"
